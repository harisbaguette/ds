{
  "name": "pattove-shell",
  "version": "0.3.0",
  "private": true,
  "description": "패토브 화면 구조 검토용 뼈대",
  "scripts": {
    "build:launcher": "node scripts/build-launcher-icon.cjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher.ps1",
    "test:launcher": "node tests/launcher.cjs",
    "build": "npm run build:system && npm run build:registry && npm run build:library",
    "build:registry": "node scripts/build-registry.mjs",
    "test:consumers": "node tests/source-consumers.cjs",
    "test:atlas": "node tests/atlas.cjs",
    "build:system": "node scripts/build-system.mjs",
    "test:system": "node tests/system.cjs",
    "test:system:audit": "node tests/system-audit.cjs",
    "build:library": "node scripts/build-library.mjs",
    "dev": "node scripts/serve.cjs",
    "test": "node tests/shell.cjs",
    "test:visual": "node tests/visual.cjs",
    "test:design": "node tests/design-audit.cjs",
    "test:outer": "node tests/outer-shell.cjs",
    "test:library": "node tests/library.cjs",
    "test:styles": "node tests/styles.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "marked": "^18.0.14",
    "next": "^16.3.6",
    "playwright-core": "1.62.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0"
  }
}
