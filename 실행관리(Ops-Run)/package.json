    "test:system": "node tests/system.cjs",
    "test:system:audit": "node tests/system-audit.cjs",
    "build:library": "node scripts/build-library.mjs",
    "dev": "node scripts/serve.cjs",
    "test": "node scripts/verify.mjs",
    "test:visual": "node tests/visual.cjs",
    "test:preview-fit": "node tests/preview-fit.cjs",
    "test:responsive": "node tests/responsive.cjs",
    "test:design": "node tests/design-audit.cjs",
    "test:outer": "node tests/outer-shell.cjs",
    "test:library": "node tests/library.cjs",
    "test:references": "node tests/references.cjs",
    "test:part-ux": "node tests/part-ux.cjs",
    "test:ui-layout": "node tests/ui-layout.cjs",
    "test:catalog-selection": "node tests/catalog-selection.cjs",
    "test:mobile-ux": "node tests/mobile-ux.cjs",
    "test:refined-ui": "node tests/refined-ui.cjs",
    "test:frontend-polish": "node tests/frontend-polish.cjs",
    "test:ux-journeys": "node tests/ux-journeys.cjs",
    "test:ux-completion": "node tests/ux-completion.cjs",
    "test:styles": "node tests/styles.cjs",
    "test:tokens": "node tests/tokens.mjs",
    "test:shell-style": "node tests/shell-style.cjs",
    "test:admin": "node tests/admin.cjs",
    "build:docs": "node scripts/sync-docs.mjs",
    "icons": "node scripts/illustrations.mjs",
    "icons:mcp": "node scripts/illustrations-mcp.mjs",
    "build:catalog": "node scripts/build-illustration-catalog.mjs",
    "test:icon-tools": "node tests/illustration-tools.mjs",
    "test:motion": "node tests/motion.cjs",
    "test:all": "node scripts/verify.mjs --all",
    "test:navigation": "node tests/navigation.cjs",
    "test:contracts": "node tests/system-contracts.mjs",
    "test:extended": "node tests/extended-parts.cjs",
    "test:audit-fixes": "node tests/audit-fixes.cjs",
    "system": "node scripts/system.mjs",
    "system:mcp": "node scripts/system-mcp.mjs",
    "configure:mcp": "node scripts/configure-mcp.mjs",
    "package:source": "node scripts/package-source.mjs",
    "test:composition": "node tests/screen-composition.mjs"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.47.5",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@phosphor-icons/core": "^2.1.1",
    "@tabler/icons": "^3.48.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/table-core": "8.21.3",
    "fflate": "0.8.3",
    "lucide-static": "^1.48.0",
    "marked": "^18.0.14",
    "next": "^16.3.6",
    "playwright-core": "1.62.1",
    "postcss": "8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
