{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pattove-main-token-aspect",
  "type": "registry:item",
  "title": "메인 스타일 · 비율 토큰",
  "description": "메인 스타일 · 비율 토큰. 그림·표본의 가로세로 비율. 비율 가로세로 비 aspect ratio",
  "files": [
    {
      "path": "design/styles/main/size.css",
      "type": "registry:file",
      "target": "~/design/styles/main/size.css",
      "content": ".ds[data-style=\"main\"]{--p-size-hairline:1px;--p-size-2xs:4px;--p-size-xs:8px;--p-size-sm:12px;--p-size-md:16px;--p-size-lg:24px;--p-size-xl:32px;--p-size-2xl:40px;--p-size-3xl:48px;--p-icon-xs:12px;--p-icon-sm:16px;--p-icon-md:20px;--p-icon-lg:24px;--p-icon-xl:28px;--p-icon-2xl:32px;--p-icon-3xl:40px;--p-control-size-sm:44px;--p-control-size-md:48px;--p-control-size-lg:56px;--p-control-size-xl:64px;}\n"
    },
    {
      "path": "design/styles/main/radius.css",
      "type": "registry:file",
      "target": "~/design/styles/main/radius.css",
      "content": ".ds[data-style=\"main\"]{--p-radius-xs:2px;--p-radius-sm:4px;--p-radius-md:8px;--p-radius-lg:12px;--p-radius-xl:16px;--p-radius-2xl:24px;--p-radius-full:999px;--p-radius-circle:50%;--p-inner-radius:var(--p-radius-lg);--p-control-radius:var(--p-radius-xl);--p-radius:var(--p-radius-2xl);}\n"
    },
    {
      "path": "design/styles/main/border.css",
      "type": "registry:file",
      "target": "~/design/styles/main/border.css",
      "content": ".ds[data-style=\"main\"]{--p-underline-offset:3px;--p-border-width:1px;--p-border-width-strong:2px;--p-border-width-focus:3px;--p-focus-offset:3px;--p-focus-offset-tight:2px;}\n"
    },
    {
      "path": "design/styles/main/aspect.css",
      "type": "registry:file",
      "target": "~/design/styles/main/aspect.css",
      "content": ".ds[data-style=\"main\"]{--p-aspect-square:1;--p-aspect-landscape:5 / 3;--p-aspect-portrait:1 / 2;}\n"
    },
    {
      "path": "design/css/token-aspect.css",
      "type": "registry:file",
      "target": "~/design/css/token-aspect.css",
      "content": ".ds .ds-token-aspect { align-items:end; }\n.ds .ds-token-aspect i { height:var(--p-control-size-sm); border:var(--p-border-width-strong) solid currentColor; border-radius:var(--p-radius-sm); aspect-ratio:var(--p-aspect-square); }\n.ds .ds-token-aspect [data-token=\"landscape\"] { aspect-ratio:var(--p-aspect-landscape); }\n.ds .ds-token-aspect [data-token=\"portrait\"] { aspect-ratio:var(--p-aspect-portrait); }"
    },
    {
      "path": "design/html/token-aspect.html",
      "type": "registry:file",
      "target": "~/design/html/token-aspect.html",
      "content": "<span class=\"ds-token-row ds-token-aspect\"><i></i><i data-token=\"landscape\"></i><i data-token=\"portrait\"></i></span>"
    }
  ],
  "meta": {
    "version": "0.7.0",
    "lifecycle": "Trial",
    "item": "token-aspect",
    "purpose": "그림·표본의 가로세로 비율",
    "keywords": "비율 가로세로 비 aspect ratio",
    "style": "main",
    "source": "src/tokens/semantic/aspect.css"
  },
  "docs": "설치한 design 폴더의 예시와 소스를 직접 수정해 사용하세요."
}
