{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pattove-main-token-container",
  "type": "registry:item",
  "title": "메인 스타일 · 너비 토큰",
  "description": "메인 스타일 · 너비 토큰. 카드·패널·페이지의 너비. 너비 폭 컨테이너 읽기 폭 container measure",
  "files": [
    {
      "path": "design/styles/main/space.css",
      "type": "registry:file",
      "target": "~/design/styles/main/space.css",
      "content": ".ds[data-style=\"main\"]{--p-space-unit:4px;--p-space-3xs:2px;--p-space-2xs:4px;--p-space-xs:8px;--p-space-sm:12px;--p-space-md:16px;--p-space-lg:24px;--p-space-xl:32px;--p-space-2xl:40px;--p-space-3xl:48px;--p-space-4xl:64px;--p-space-5xl:80px;}\n"
    },
    {
      "path": "design/styles/main/size.css",
      "type": "registry:file",
      "target": "~/design/styles/main/size.css",
      "content": ".ds[data-style=\"main\"]{--p-size-hairline:1px;--p-size-2xs:4px;--p-size-xs:8px;--p-size-sm:12px;--p-size-md:16px;--p-size-lg:24px;--p-size-xl:32px;--p-size-2xl:40px;--p-size-3xl:48px;--p-icon-xs:12px;--p-icon-sm:16px;--p-icon-md:20px;--p-icon-lg:24px;--p-icon-xl:28px;--p-icon-2xl:32px;--p-icon-3xl:40px;--p-control-size-sm:44px;--p-control-size-md:48px;--p-control-size-lg:56px;--p-control-size-xl:64px;}\n"
    },
    {
      "path": "design/styles/main/container.css",
      "type": "registry:file",
      "target": "~/design/styles/main/container.css",
      "content": ".ds[data-style=\"main\"]{--p-measure-narrow:60ch;--p-measure:72ch;--p-container-2xs:256px;--p-container-xs:288px;--p-container-sm:384px;--p-container-md:512px;--p-container-lg:576px;--p-container-xl:1024px;--p-container-2xl:1280px;}\n"
    },
    {
      "path": "design/styles/main/radius.css",
      "type": "registry:file",
      "target": "~/design/styles/main/radius.css",
      "content": ".ds[data-style=\"main\"]{--p-radius-xs:2px;--p-radius-sm:4px;--p-radius-md:8px;--p-radius-lg:12px;--p-radius-xl:16px;--p-radius-2xl:24px;--p-radius-full:999px;--p-radius-circle:50%;--p-inner-radius:var(--p-radius-lg);--p-control-radius:var(--p-radius-xl);--p-radius:var(--p-radius-2xl);}\n"
    },
    {
      "path": "design/css/token-container.css",
      "type": "registry:file",
      "target": "~/design/css/token-container.css",
      "content": ".ds .ds-token-container { display:grid; gap:var(--p-space-xs); justify-items:start; }\n.ds .ds-token-container i { display:block; height:var(--p-size-xs); border-radius:var(--p-radius-full); background:currentColor; width:calc(var(--p-measure-narrow) / 10); }\n.ds .ds-token-container [data-token=\"measure\"] { width:calc(var(--p-measure) / 10); }\n.ds .ds-token-container [data-token=\"xs\"] { width:calc(var(--p-container-xs) / 10); }\n.ds .ds-token-container [data-token=\"lg\"] { width:calc(var(--p-container-lg) / 10); }"
    },
    {
      "path": "design/html/token-container.html",
      "type": "registry:file",
      "target": "~/design/html/token-container.html",
      "content": "<span class=\"ds-token-row ds-token-container\"><i></i><i data-token=\"measure\"></i><i data-token=\"xs\"></i><i data-token=\"lg\"></i></span>"
    }
  ],
  "meta": {
    "version": "0.7.0",
    "lifecycle": "Trial",
    "item": "token-container",
    "purpose": "카드·패널·페이지의 너비",
    "keywords": "너비 폭 컨테이너 읽기 폭 container measure",
    "style": "main",
    "source": "src/tokens/semantic/container.css"
  },
  "docs": "설치한 design 폴더의 예시와 소스를 직접 수정해 사용하세요."
}
