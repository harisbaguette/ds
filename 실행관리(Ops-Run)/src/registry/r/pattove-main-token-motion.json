{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pattove-main-token-motion",
  "type": "registry:item",
  "title": "메인 스타일 · 움직임 토큰",
  "description": "메인 스타일 · 움직임 토큰. 상태 전환 시간과 가속 곡선. 움직임 시간 전환 애니메이션 가속 motion duration easing",
  "files": [
    {
      "path": "design/styles/main/space.css",
      "type": "registry:file",
      "target": "~/design/styles/main/space.css",
      "content": ".ds[data-style=\"main\"]{--p-space-unit:4px;--p-space-3xs:2px;--p-space-2xs:4px;--p-space-xs:8px;--p-space-sm:12px;--p-space-md:16px;--p-space-lg:24px;--p-space-xl:32px;--p-space-2xl:40px;--p-space-3xl:48px;--p-space-4xl:64px;--p-space-5xl:80px;}\n"
    },
    {
      "path": "design/styles/main/size.css",
      "type": "registry:file",
      "target": "~/design/styles/main/size.css",
      "content": ".ds[data-style=\"main\"]{--p-size-hairline:1px;--p-size-2xs:4px;--p-size-xs:8px;--p-size-sm:12px;--p-size-md:16px;--p-size-lg:24px;--p-size-xl:32px;--p-size-2xl:40px;--p-size-3xl:48px;--p-icon-xs:12px;--p-icon-sm:16px;--p-icon-md:20px;--p-icon-lg:24px;--p-icon-xl:28px;--p-icon-2xl:32px;--p-icon-3xl:40px;--p-control-size-sm:44px;--p-control-size-md:48px;--p-control-size-lg:56px;--p-control-size-xl:64px;}\n"
    },
    {
      "path": "design/styles/main/radius.css",
      "type": "registry:file",
      "target": "~/design/styles/main/radius.css",
      "content": ".ds[data-style=\"main\"]{--p-radius-xs:2px;--p-radius-sm:4px;--p-radius-md:8px;--p-radius-lg:12px;--p-radius-xl:16px;--p-radius-2xl:24px;--p-radius-full:999px;--p-radius-circle:50%;--p-inner-radius:var(--p-radius-lg);--p-control-radius:var(--p-radius-xl);--p-radius:var(--p-radius-2xl);}\n"
    },
    {
      "path": "design/styles/main/border.css",
      "type": "registry:file",
      "target": "~/design/styles/main/border.css",
      "content": ".ds[data-style=\"main\"]{--p-underline-offset:3px;--p-border-width:1px;--p-border-width-strong:2px;--p-border-width-focus:3px;--p-focus-offset:3px;--p-focus-offset-tight:2px;}\n"
    },
    {
      "path": "design/styles/main/motion.css",
      "type": "registry:file",
      "target": "~/design/styles/main/motion.css",
      "content": ".ds[data-style=\"main\"]{--p-rise-sm:1px;--p-rise-md:2px;--p-duration:140ms;--p-duration-spin:800ms;--p-ease-standard:cubic-bezier(.2, 0, .38, .9);--p-ease-enter:cubic-bezier(0, 0, .38, .9);--p-ease-linear:linear;}\n"
    },
    {
      "path": "design/css/token-motion.css",
      "type": "registry:file",
      "target": "~/design/css/token-motion.css",
      "content": ".ds .ds-token-motion { position:relative; display:block; width:calc(var(--p-space-unit) * 40); height:var(--p-size-lg); border:var(--p-border-width-strong) solid currentColor; border-radius:var(--p-radius-lg); }\n.ds .ds-token-motion i { position:absolute; top:var(--p-space-3xs); left:var(--p-space-3xs); width:var(--p-size-md); height:var(--p-size-md); border-radius:var(--p-radius-circle); background:currentColor; transition:transform var(--p-duration) var(--p-ease-standard); }\n.ds .ds-token-motion:hover i { transform:translateX(calc(var(--p-space-unit) * 40 - var(--p-size-lg))); }"
    },
    {
      "path": "design/html/token-motion.html",
      "type": "registry:file",
      "target": "~/design/html/token-motion.html",
      "content": "<span class=\"ds-token-motion\" aria-label=\"전환 시간 표본\"><i></i></span>"
    }
  ],
  "meta": {
    "version": "0.6.0",
    "lifecycle": "Trial",
    "item": "token-motion",
    "dictionary": "TOK-113",
    "purpose": "상태 전환 시간과 가속 곡선",
    "keywords": "움직임 시간 전환 애니메이션 가속 motion duration easing",
    "style": "main",
    "source": "src/tokens/semantic/motion.css"
  },
  "docs": "설치한 design 폴더의 예시와 소스를 직접 수정해 사용하세요."
}
