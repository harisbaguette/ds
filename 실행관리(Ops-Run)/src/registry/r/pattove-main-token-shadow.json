{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pattove-main-token-shadow",
  "type": "registry:item",
  "title": "메인 스타일 · 그림자 토큰",
  "description": "메인 스타일 · 그림자 토큰. 띄움·눌림·떠 있는 층의 그림자. 그림자 입체 층 깊이 shadow elevation",
  "files": [
    {
      "path": "design/styles/main/space.css",
      "type": "registry:file",
      "target": "~/design/styles/main/space.css",
      "content": ".ds[data-style=\"main\"]{--p-space-unit:4px;--p-space-3xs:2px;--p-space-2xs:4px;--p-space-xs:8px;--p-space-sm:12px;--p-space-md:16px;--p-space-lg:24px;--p-space-xl:32px;--p-space-2xl:40px;--p-space-3xl:48px;--p-space-4xl:64px;--p-space-5xl:80px;}\n"
    },
    {
      "path": "design/styles/main/size.css",
      "type": "registry:file",
      "target": "~/design/styles/main/size.css",
      "content": ".ds[data-style=\"main\"]{--p-size-hairline:1px;--p-size-2xs:4px;--p-size-xs:8px;--p-size-sm:12px;--p-size-md:16px;--p-size-lg:24px;--p-size-xl:32px;--p-size-2xl:40px;--p-size-3xl:48px;--p-icon-xs:12px;--p-icon-sm:16px;--p-icon-md:20px;--p-icon-lg:24px;--p-icon-xl:28px;--p-icon-2xl:32px;--p-icon-3xl:40px;--p-control-size-sm:44px;--p-control-size-md:48px;--p-control-size-lg:56px;--p-control-size-xl:64px;}\n"
    },
    {
      "path": "design/styles/main/radius.css",
      "type": "registry:file",
      "target": "~/design/styles/main/radius.css",
      "content": ".ds[data-style=\"main\"]{--p-radius-xs:2px;--p-radius-sm:4px;--p-radius-md:8px;--p-radius-lg:12px;--p-radius-xl:16px;--p-radius-2xl:24px;--p-radius-full:999px;--p-radius-circle:50%;--p-inner-radius:var(--p-radius-lg);--p-control-radius:var(--p-radius-xl);--p-radius:var(--p-radius-2xl);}\n"
    },
    {
      "path": "design/styles/main/shadow.css",
      "type": "registry:file",
      "target": "~/design/styles/main/shadow.css",
      "content": ".ds[data-style=\"main\"]{--p-shadow:6px 7px 16px #bbc4d166, -5px -5px 14px #ffffffed;--p-raised:3px 4px 8px #b9c3d066, -3px -3px 8px #ffffffed;--p-inset:inset 3px 3px 6px #b7c1cf55, inset -3px -3px 6px #ffffffd9;--p-pressed:inset 3px 3px 6px #15222f60,inset -1px -1px 3px #ffffff18;--p-float:0 12px 32px #26394d26;--p-lift:0 3px 5px #24314526;--p-control-shadow:0 3px 5px #24314526,inset 0 1px 0 #ffffff24;--p-selected-shadow:0 2px 5px #24314526;--p-knob-shadow:0 1px 3px #26344726;--p-glass-shadow:0 8px 24px #38465e12;--p-dialog-shadow:0 24px 80px #26344740;--p-drop:0 10px 12px #24293616;--p-ring:inset 0 0 0 2px #24293610;--p-focus-glow:0 0 0 2px #ed667b33;--p-stage-shadow:0 24px 44px -28px #303b4873;}\n"
    },
    {
      "path": "design/css/token-shadow.css",
      "type": "registry:file",
      "target": "~/design/css/token-shadow.css",
      "content": ".ds .ds-token-shadow { gap:calc(var(--p-space-unit) * 5); padding:var(--p-space-sm); }\n.ds .ds-token-shadow i { width:var(--p-control-size-md); height:var(--p-control-size-md); border-radius:var(--p-inner-radius); box-shadow:var(--p-raised); }\n.ds .ds-token-shadow [data-token=\"shadow\"] { box-shadow:var(--p-shadow); }\n.ds .ds-token-shadow [data-token=\"inset\"] { box-shadow:var(--p-inset); }\n.ds .ds-token-shadow [data-token=\"float\"] { box-shadow:var(--p-float); }"
    },
    {
      "path": "design/html/token-shadow.html",
      "type": "registry:file",
      "target": "~/design/html/token-shadow.html",
      "content": "<span class=\"ds-token-row ds-token-shadow\"><i></i><i data-token=\"shadow\"></i><i data-token=\"inset\"></i><i data-token=\"float\"></i></span>"
    }
  ],
  "meta": {
    "version": "0.6.0",
    "lifecycle": "Trial",
    "item": "token-shadow",
    "dictionary": "TOK-95",
    "purpose": "띄움·눌림·떠 있는 층의 그림자",
    "keywords": "그림자 입체 층 깊이 shadow elevation",
    "style": "main",
    "source": "src/tokens/semantic/shadow.css"
  },
  "docs": "설치한 design 폴더의 예시와 소스를 직접 수정해 사용하세요."
}
