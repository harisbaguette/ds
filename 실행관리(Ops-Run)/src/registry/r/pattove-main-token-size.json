{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pattove-main-token-size",
  "type": "registry:item",
  "title": "메인 스타일 · 크기 토큰",
  "description": "메인 스타일 · 크기 토큰. 상자·아이콘·조작 요소의 크기. 크기 너비 높이 아이콘 조작 크기 size",
  "files": [
    {
      "path": "design/styles/main/size.css",
      "type": "registry:file",
      "target": "~/design/styles/main/size.css",
      "content": ".ds[data-style=\"main\"]{--p-size-hairline:1px;--p-size-2xs:4px;--p-size-xs:8px;--p-size-sm:12px;--p-size-md:16px;--p-size-lg:24px;--p-size-xl:32px;--p-size-2xl:40px;--p-size-3xl:48px;--p-icon-xs:12px;--p-icon-sm:16px;--p-icon-md:20px;--p-icon-lg:24px;--p-icon-xl:28px;--p-icon-2xl:32px;--p-icon-3xl:40px;--p-control-size-sm:44px;--p-control-size-md:48px;--p-control-size-lg:56px;--p-control-size-xl:64px;}\n"
    },
    {
      "path": "design/styles/main/radius.css",
      "type": "registry:file",
      "target": "~/design/styles/main/radius.css",
      "content": ".ds[data-style=\"main\"]{--p-radius-xs:2px;--p-radius-sm:4px;--p-radius-md:8px;--p-radius-lg:12px;--p-radius-xl:16px;--p-radius-2xl:24px;--p-radius-full:999px;--p-radius-circle:50%;--p-inner-radius:var(--p-radius-lg);--p-control-radius:var(--p-radius-xl);--p-radius:var(--p-radius-2xl);}\n"
    },
    {
      "path": "design/css/token-size.css",
      "type": "registry:file",
      "target": "~/design/css/token-size.css",
      "content": ".ds .ds-token-size { align-items:end; }\n.ds .ds-token-size i { width:var(--p-icon-sm); height:var(--p-icon-sm); border-radius:var(--p-radius-sm); background:currentColor; }\n.ds .ds-token-size [data-token=\"icon-md\"] { width:var(--p-icon-md); height:var(--p-icon-md); }\n.ds .ds-token-size [data-token=\"icon-lg\"] { width:var(--p-icon-lg); height:var(--p-icon-lg); }\n.ds .ds-token-size [data-token=\"control\"] { width:var(--p-control-size-sm); height:var(--p-control-size-sm); border-radius:var(--p-inner-radius); }"
    },
    {
      "path": "design/html/token-size.html",
      "type": "registry:file",
      "target": "~/design/html/token-size.html",
      "content": "<span class=\"ds-token-row ds-token-size\"><i></i><i data-token=\"icon-md\"></i><i data-token=\"icon-lg\"></i><i data-token=\"control\"></i></span>"
    }
  ],
  "meta": {
    "version": "0.3.0",
    "lifecycle": "Trial",
    "item": "token-size",
    "purpose": "상자·아이콘·조작 요소의 크기",
    "keywords": "크기 너비 높이 아이콘 조작 크기 size",
    "style": "main",
    "source": "src/tokens/semantic/size.css"
  },
  "docs": "설치한 design 폴더의 예시와 소스를 직접 수정해 사용하세요."
}
