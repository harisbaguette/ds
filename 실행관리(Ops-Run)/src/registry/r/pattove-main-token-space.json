{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pattove-main-token-space",
  "type": "registry:item",
  "title": "메인 스타일 · 간격 토큰",
  "description": "메인 스타일 · 간격 토큰. 여백과 간격의 단계. 간격 여백 거리 spacing space",
  "files": [
    {
      "path": "design/styles/main/space.css",
      "type": "registry:file",
      "target": "~/design/styles/main/space.css",
      "content": ".ds[data-style=\"main\"]{--p-space-unit:4px;--p-space-3xs:2px;--p-space-2xs:4px;--p-space-xs:8px;--p-space-sm:12px;--p-space-md:16px;--p-space-lg:24px;--p-space-xl:32px;--p-space-2xl:40px;--p-space-3xl:48px;--p-space-4xl:64px;--p-space-5xl:80px;}\n"
    },
    {
      "path": "design/styles/main/size.css",
      "type": "registry:file",
      "target": "~/design/styles/main/size.css",
      "content": ".ds[data-style=\"main\"]{--p-size-hairline:1px;--p-size-2xs:4px;--p-size-xs:8px;--p-size-sm:12px;--p-size-md:16px;--p-size-lg:24px;--p-size-xl:32px;--p-size-2xl:40px;--p-size-3xl:48px;--p-icon-xs:12px;--p-icon-sm:16px;--p-icon-md:20px;--p-icon-lg:24px;--p-icon-xl:28px;--p-icon-2xl:32px;--p-icon-3xl:40px;--p-control-size-sm:44px;--p-control-size-md:48px;--p-control-size-lg:56px;--p-control-size-xl:64px;}\n"
    },
    {
      "path": "design/styles/main/radius.css",
      "type": "registry:file",
      "target": "~/design/styles/main/radius.css",
      "content": ".ds[data-style=\"main\"]{--p-radius-xs:2px;--p-radius-sm:4px;--p-radius-md:8px;--p-radius-lg:12px;--p-radius-xl:16px;--p-radius-2xl:24px;--p-radius-full:999px;--p-radius-circle:50%;--p-inner-radius:var(--p-radius-lg);--p-control-radius:var(--p-radius-xl);--p-radius:var(--p-radius-2xl);}\n"
    },
    {
      "path": "design/css/token-space.css",
      "type": "registry:file",
      "target": "~/design/css/token-space.css",
      "content": ".ds .ds-token-space { display:grid; gap:var(--p-space-xs); justify-items:start; }\n.ds .ds-token-space i { display:block; height:var(--p-size-xs); border-radius:var(--p-radius-full); background:currentColor; }\n.ds .ds-token-space [data-token=\"xs\"] { width:calc(var(--p-space-xs) * 4); }\n.ds .ds-token-space [data-token=\"sm\"] { width:calc(var(--p-space-sm) * 4); }\n.ds .ds-token-space [data-token=\"md\"] { width:calc(var(--p-space-md) * 4); }\n.ds .ds-token-space [data-token=\"lg\"] { width:calc(var(--p-space-lg) * 4); }\n.ds .ds-token-space [data-token=\"xl\"] { width:calc(var(--p-space-xl) * 4); }"
    },
    {
      "path": "design/html/token-space.html",
      "type": "registry:file",
      "target": "~/design/html/token-space.html",
      "content": "<span class=\"ds-token-row ds-token-space\"><i data-token=\"xs\"></i><i data-token=\"sm\"></i><i data-token=\"md\"></i><i data-token=\"lg\"></i><i data-token=\"xl\"></i></span>"
    }
  ],
  "meta": {
    "version": "0.3.0",
    "lifecycle": "Trial",
    "item": "token-space",
    "dictionary": "TOK-76",
    "purpose": "여백과 간격의 단계",
    "keywords": "간격 여백 거리 spacing space",
    "style": "main",
    "source": "src/tokens/semantic/space.css"
  },
  "docs": "설치한 design 폴더의 예시와 소스를 직접 수정해 사용하세요."
}
