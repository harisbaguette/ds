{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pattove-main-token-stroke",
  "type": "registry:item",
  "title": "메인 스타일 · 선 모양 토큰",
  "description": "메인 스타일 · 선 모양 토큰. 선 모양과 아이콘 선 굵기. 선 모양 점선 파선 아이콘 선 굵기 stroke dashed dotted",
  "files": [
    {
      "path": "design/styles/main/size.css",
      "type": "registry:file",
      "target": "~/design/styles/main/size.css",
      "content": ".ds[data-style=\"main\"]{--p-size-hairline:1px;--p-size-2xs:4px;--p-size-xs:8px;--p-size-sm:12px;--p-size-md:16px;--p-size-lg:24px;--p-size-xl:32px;--p-size-2xl:40px;--p-size-3xl:48px;--p-icon-xs:12px;--p-icon-sm:16px;--p-icon-md:20px;--p-icon-lg:24px;--p-icon-xl:28px;--p-icon-2xl:32px;--p-icon-3xl:40px;--p-control-size-sm:44px;--p-control-size-md:48px;--p-control-size-lg:56px;--p-control-size-xl:64px;}\n"
    },
    {
      "path": "design/styles/main/radius.css",
      "type": "registry:file",
      "target": "~/design/styles/main/radius.css",
      "content": ".ds[data-style=\"main\"]{--p-radius-xs:2px;--p-radius-sm:4px;--p-radius-md:8px;--p-radius-lg:12px;--p-radius-xl:16px;--p-radius-2xl:24px;--p-radius-full:999px;--p-radius-circle:50%;--p-inner-radius:var(--p-radius-lg);--p-control-radius:var(--p-radius-xl);--p-radius:var(--p-radius-2xl);}\n"
    },
    {
      "path": "design/styles/main/border.css",
      "type": "registry:file",
      "target": "~/design/styles/main/border.css",
      "content": ".ds[data-style=\"main\"]{--p-underline-offset:3px;--p-border-width:1px;--p-border-width-strong:2px;--p-border-width-focus:3px;--p-focus-offset:3px;--p-focus-offset-tight:2px;}\n"
    },
    {
      "path": "design/styles/main/stroke.css",
      "type": "registry:file",
      "target": "~/design/styles/main/stroke.css",
      "content": ".ds[data-style=\"main\"]{--p-stroke-dashed:dashed;--p-stroke-dotted:dotted;--p-stroke-slant:18deg;--p-icon-stroke-heavy:2.2;--p-icon-stroke:1.6;--p-icon-stroke-bold:2;--p-icon-stroke-thin:1.3;}\n"
    },
    {
      "path": "design/css/token-stroke.css",
      "type": "registry:file",
      "target": "~/design/css/token-stroke.css",
      "content": ".ds .ds-token-stroke i { width:var(--p-control-size-sm); height:var(--p-control-size-sm); border-radius:var(--p-inner-radius); border:var(--p-border-width-strong) var(--p-stroke-dashed) currentColor; }\n.ds .ds-token-stroke [data-token=\"dotted\"] { border-style:var(--p-stroke-dotted); }"
    },
    {
      "path": "design/html/token-stroke.html",
      "type": "registry:file",
      "target": "~/design/html/token-stroke.html",
      "content": "<span class=\"ds-token-row ds-token-stroke\"><i></i><i data-token=\"dotted\"></i></span>"
    }
  ],
  "meta": {
    "version": "0.8.0",
    "lifecycle": "Trial",
    "item": "token-stroke",
    "purpose": "선 모양과 아이콘 선 굵기",
    "keywords": "선 모양 점선 파선 아이콘 선 굵기 stroke dashed dotted",
    "style": "main",
    "source": "src/tokens/semantic/stroke.css"
  },
  "docs": "설치한 design 폴더의 예시와 소스를 직접 수정해 사용하세요."
}
