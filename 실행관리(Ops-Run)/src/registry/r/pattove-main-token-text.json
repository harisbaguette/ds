      "type": "registry:file",
      "target": "~/design/styles/main/typography.css",
      "content": ".ds[data-style=\"main\"]{--p-font:Pretendard, sans-serif;--p-display-font:Outfit, Pretendard, sans-serif;--p-type-body:var(--p-text-md)/var(--p-leading-normal) var(--p-font);--p-type-display:var(--p-weight-semibold) var(--p-text-display-sm) var(--p-display-font);--p-type-figure:var(--p-weight-bold) var(--p-text-md)/var(--p-leading-none) var(--p-display-font);--p-type-stat:var(--p-weight-bold) var(--p-text-title-lg)/var(--p-leading-snug) var(--p-display-font);}\n"
    },
    {
      "path": "design/styles/main/text.css",
      "type": "registry:file",
      "target": "~/design/styles/main/text.css",
      "content": ".ds[data-style=\"main\"]{--p-text-micro:10px;--p-text-caption:11px;--p-text-label:12px;--p-text-sm:13px;--p-text-body:14px;--p-text-body-lg:15px;--p-text-md:16px;--p-text-title-sm:18px;--p-text-title:20px;--p-text-title-lg:22px;--p-text-lg:24px;--p-text-heading-sm:26px;--p-text-heading:28px;--p-text-heading-lg:30px;--p-text-heading-xl:32px;--p-text-display-sm:38px;--p-text-display:40px;--p-text-display-lg:42px;--p-text-display-xl:45px;--p-text-glyph:48px;--p-text-display-2xl:52px;--p-text-glyph-xl:160px;}\n"
    },
    {
      "path": "design/styles/main/weight.css",
      "type": "registry:file",
      "target": "~/design/styles/main/weight.css",
      "content": ".ds[data-style=\"main\"]{--p-weight-light:300;--p-weight-regular:400;--p-weight-medium:500;--p-weight-medium-plus:550;--p-weight-semibold:600;--p-weight-semibold-plus:650;--p-weight-bold:700;--p-weight-bold-plus:750;--p-weight-extrabold:800;}\n"
    },
    {
      "path": "design/styles/main/leading.css",
      "type": "registry:file",
      "target": "~/design/styles/main/leading.css",
      "content": ".ds[data-style=\"main\"]{--p-leading-none:1;--p-leading-tight:1.1;--p-leading-snug:1.2;--p-leading-compact:1.3;--p-leading-cozy:1.4;--p-leading-normal:1.5;--p-leading-relaxed:1.6;--p-leading-loose:1.7;--p-leading-looser:1.8;}\n"
    },
    {
      "path": "design/css/token-text.css",
      "type": "registry:file",
      "target": "~/design/css/token-text.css",
      "content": ".ds .ds-token-text { align-items:baseline; font-family:var(--p-font); }\n.ds .ds-token-text [data-token=\"label\"] { font-size:var(--p-text-label); }\n.ds .ds-token-text [data-token=\"body\"] { font-size:var(--p-text-body); }\n.ds .ds-token-text [data-token=\"title\"] { font-size:var(--p-text-title); }\n.ds .ds-token-text [data-token=\"heading\"] { font-size:var(--p-text-heading); }\n.ds .ds-token-text [data-token=\"display-sm\"] { font-size:var(--p-text-display-sm); }"
    },
    {
      "path": "design/html/token-text.html",
      "type": "registry:file",
      "target": "~/design/html/token-text.html",
      "content": "<span class=\"ds-token-row ds-token-text\"><span data-token=\"label\">가</span><span data-token=\"body\">가</span><span data-token=\"title\">가</span><span data-token=\"heading\">가</span><span data-token=\"display-sm\">가</span></span>"
    }
  ],
