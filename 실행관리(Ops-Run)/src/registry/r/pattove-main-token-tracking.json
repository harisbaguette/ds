{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pattove-main-token-tracking",
  "type": "registry:item",
  "title": "메인 스타일 · 자간 토큰",
  "description": "메인 스타일 · 자간 토큰. 자간 단계. 자간 글자 사이 letter-spacing tracking",
  "files": [
    {
      "path": "design/styles/main/typography.css",
      "type": "registry:file",
      "target": "~/design/styles/main/typography.css",
      "content": ".ds[data-style=\"main\"]{--p-font:Pretendard, sans-serif;--p-display-font:Outfit, Pretendard, sans-serif;--p-type-body:var(--p-text-md)/var(--p-leading-normal) var(--p-font);--p-type-display:var(--p-weight-semibold) var(--p-text-display) var(--p-display-font);--p-type-figure:var(--p-weight-bold) var(--p-text-md)/var(--p-leading-none) var(--p-display-font);--p-type-stat:var(--p-weight-bold) var(--p-text-lg)/var(--p-leading-tight) var(--p-display-font);}\n"
    },
    {
      "path": "design/styles/main/text.css",
      "type": "registry:file",
      "target": "~/design/styles/main/text.css",
      "content": ".ds[data-style=\"main\"]{--p-text-sm:12px;--p-text-body:14px;--p-text-md:16px;--p-text-title-sm:18px;--p-text-title:20px;--p-text-lg:24px;--p-text-heading:30px;--p-text-display:40px;}\n"
    },
    {
      "path": "design/styles/main/weight.css",
      "type": "registry:file",
      "target": "~/design/styles/main/weight.css",
      "content": ".ds[data-style=\"main\"]{--p-weight-light:300;--p-weight-regular:400;--p-weight-medium:500;--p-weight-semibold:600;--p-weight-bold:700;--p-weight-extrabold:800;}\n"
    },
    {
      "path": "design/styles/main/leading.css",
      "type": "registry:file",
      "target": "~/design/styles/main/leading.css",
      "content": ".ds[data-style=\"main\"]{--p-leading-none:1;--p-leading-tight:1.2;--p-leading-snug:1.35;--p-leading-normal:1.5;--p-leading-relaxed:1.65;--p-leading-loose:1.8;}\n"
    },
    {
      "path": "design/styles/main/tracking.css",
      "type": "registry:file",
      "target": "~/design/styles/main/tracking.css",
      "content": ".ds[data-style=\"main\"]{--p-tracking-tighter:-.04em;--p-tracking-tight:-.02em;--p-tracking-wide:.03em;}\n"
    },
    {
      "path": "design/styles/main/space.css",
      "type": "registry:file",
      "target": "~/design/styles/main/space.css",
      "content": ".ds[data-style=\"main\"]{--p-space-unit:4px;--p-space-3xs:2px;--p-space-2xs:4px;--p-space-xs:8px;--p-space-sm:12px;--p-space-md:16px;--p-space-lg:24px;--p-space-xl:32px;--p-space-2xl:40px;--p-space-3xl:48px;--p-space-4xl:64px;--p-space-5xl:80px;}\n"
    },
    {
      "path": "design/css/token-tracking.css",
      "type": "registry:file",
      "target": "~/design/css/token-tracking.css",
      "content": ".ds .ds-token-tracking { display:grid; gap:var(--p-space-xs); justify-items:start; font-size:var(--p-text-title); font-family:var(--p-display-font); }\r\n.ds .ds-token-tracking [data-token=\"tighter\"] { letter-spacing:var(--p-tracking-tighter); }\r\n.ds .ds-token-tracking [data-token=\"tight\"] { letter-spacing:var(--p-tracking-tight); }\r\n.ds .ds-token-tracking [data-token=\"wide\"] { letter-spacing:var(--p-tracking-wide); }"
    },
    {
      "path": "design/html/token-tracking.html",
      "type": "registry:file",
      "target": "~/design/html/token-tracking.html",
      "content": "<span class=\"ds-token-row ds-token-tracking\"><span data-token=\"tighter\">Aa 가나</span><span data-token=\"tight\">Aa 가나</span><span data-token=\"wide\">Aa 가나</span></span>"
    }
  ],
  "meta": {
